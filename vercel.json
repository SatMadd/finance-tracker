{
    "version": 2,
    "framework": null,
    "buildCommand": "npm ci && npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "/robots.txt",
            "dest": "/public/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_TIMEZONE": "Asia/Jakarta",
        "APP_URL": "https://finance-tracker-eta-brown.vercel.app",
        "ASSET_URL": "https://finance-tracker-eta-brown.vercel.app",
        "DB_CONNECTION": "pgsql",
        "DB_HOST": "aws-1-ap-southeast-2.pooler.supabase.com",
        "DB_PORT": "5432",
        "DB_DATABASE": "postgres",
        "DB_USERNAME": "postgres.kclmtwtekfgknumczhir",
        "SESSION_DRIVER": "database",
        "CACHE_STORE": "database",
        "QUEUE_CONNECTION": "sync",
        "LOG_CHANNEL": "stderr",
        "MAIL_MAILER": "log",
        "MAIL_FROM_ADDRESS": "onboarding@resend.dev",
        "MAIL_FROM_NAME": "Daily Ledger"
    }
}
